    "test": "bun test"
  },
  "dependencies": {
    "@mantine/core": "^9.7.0",
    "@mantine/form": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "@mantine/notifications": "^9.7.0",
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.19",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
