{
  "name": "@highstack/debug-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-only React diagnostic client for the Crashsim operator stream",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
