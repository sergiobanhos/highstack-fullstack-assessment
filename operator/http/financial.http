@baseUrl = http://localhost:3000
# Cole aqui o token retornado por auth.http.
@token = cole-o-token-aqui
# Use o UUID de um jogador com carteira criada.
@playerId = 00000000-0000-4000-8000-000000000001
@webhookTimestamp = {{$timestamp}}
# Webhooks exigem HMAC-SHA256 de `${timestamp}.${body}` com ENGINE_WEBHOOK_SECRET.
@webhookSignature = cole-a-assinatura-hmac-aqui

### Consultar carteira
GET {{baseUrl}}/wallet
Authorization: Bearer {{token}}
Accept: application/json

### Consultar lançamentos
GET {{baseUrl}}/wallet/transactions?limit=20
Authorization: Bearer {{token}}
Accept: application/json

### Adicionar saldo de teste (local)
POST {{baseUrl}}/wallet/top-ups
Authorization: Bearer {{token}}
Idempotency-Key: 4503bbfc-944c-4931-a3d4-b48b90b8a9e2
Content-Type: application/json

{
  "amount": 10000
}

### Debitar aposta (webhook Crashsim)
# Assine o timestamp e o JSON exatos desta requisição.
POST {{baseUrl}}/wallet/debit
Content-Type: application/json
x-timestamp: {{webhookTimestamp}}
x-signature: {{webhookSignature}}

{"txId":"3a50c6c6-18fa-487e-893f-5f2d41d34d58","playerId":"{{playerId}}","amount":500,"betId":"http-test-bet-1","roundId":"http-test-round-1"}

### Creditar cashout (webhook Crashsim)
# Gere a assinatura para o JSON desta requisição.
POST {{baseUrl}}/wallet/credit
Content-Type: application/json
x-timestamp: {{webhookTimestamp}}
x-signature: {{webhookSignature}}

{"txId":"0cb479a4-2f71-45b6-86c2-31159a521330","playerId":"{{playerId}}","amount":750,"betId":"http-test-bet-1","roundId":"http-test-round-1"}
